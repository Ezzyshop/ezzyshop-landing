---
import { T, type Lang } from '../i18n/translations';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = T[lang];

const cols = [
  { title: t.foot_prod, links: t.foot_links_prod },
  { title: t.foot_comp, links: t.foot_links_comp },
  { title: t.foot_help, links: t.foot_links_help },
];
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div>
        <img src="/logo-dark.png" alt="Ezzyshop" style="height:32px;width:auto;" />
        <p class="footer-tagline">{t.foot_tagline}</p>
      </div>
      {cols.map((col) => (
        <div class="footer-col">
          <h4>{col.title}</h4>
          <div class="footer-links">
            {col.links.map((link) => (
              <a href="#" class="footer-link">{link}</a>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="footer-bottom">
      <div class="footer-copy">{t.copy}</div>
      <div style="display:flex;gap:16px;">
        <a href="https://t.me/ezzyshop" class="footer-link">Telegram</a>
        <a href="https://instagram.com/ezzyshop" class="footer-link">Instagram</a>
      </div>
    </div>
  </div>
</footer>
