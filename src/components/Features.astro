---
import { T, type Lang } from '../i18n/translations';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = T[lang];

const bgs = ['#f4facc','#f4facc','#fef3c7','#f4facc','#f4facc','#f4facc'];
const colors = ['#8aaa00','#8aaa00','#d97706','#8aaa00','#8aaa00','#8aaa00'];
const icons = [
  `<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M9 1l7 4v8l-7 4-7-4V5l7-4z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M9 1v16M2 5l7 4 7-4" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>`,
  `<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M6 4h10M6 9h10M6 14h10M2 4h1M2 9h1M2 14h1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>`,
  `<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="7" cy="6" r="3" stroke="currentColor" stroke-width="1.7"/><path d="M1 16c0-3.314 2.686-6 6-6s6 2.686 6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M12 4c1.657 0 3 1.343 3 3s-1.343 3-3 3M15 13c1.105.693 2 1.868 2 3.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>`,
  `<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M9 1l2.16 5.26L17 7.27l-4 3.9.94 5.5L9 14 5.06 16.67l.94-5.5L2 7.27l5.84-.01L9 1z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>`,
  `<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M1 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><rect x="3" y="9" width="3" height="8" rx="1.5" fill="currentColor" opacity=".7"/><rect x="7.5" y="5" width="3" height="12" rx="1.5" fill="currentColor"/><rect x="12" y="12" width="3" height="5" rx="1.5" fill="currentColor" opacity=".7"/></svg>`,
  `<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M9 1l6 3v5c0 3.6-2.6 6.9-6 8-3.4-1.1-6-4.4-6-8V4l6-3z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M6 9l2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
];
---

<section class="section" id="features-grid">
  <div class="container">
    <div class="section-head center reveal">
      <div class="section-tag">{t.feat_tag}</div>
      <h2 class="section-title">{t.feat_title}</h2>
    </div>
    <div class="features-grid">
      {t.feats.map((f, i) => (
        <div class="feature-card reveal" style={`transition-delay:${i * 0.07}s`}>
          <div
            class="feature-icon-wrap"
            style={`background:${bgs[i]};color:${colors[i]}`}
            set:html={icons[i]}
          ></div>
          <div class="feature-title">{f.title}</div>
          <div class="feature-desc">{f.desc}</div>
        </div>
      ))}
    </div>
  </div>
</section>
