---
import { T, type Lang } from '../i18n/translations';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = T[lang];

const iconBgs = ['#f4facc', '#f4facc', '#f4facc', '#fef3c7'];
const iconColors = ['#8aaa00', '#8aaa00', '#8aaa00', '#d97706'];
const icons = [
  `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M11 2L4 11h6l-1 7 7-9h-6l1-7z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="3" y="7" width="14" height="10" rx="3" stroke="currentColor" stroke-width="1.8"/><circle cx="7.5" cy="12" r="1.5" fill="currentColor"/><circle cx="12.5" cy="12" r="1.5" fill="currentColor"/><path d="M10 7V4M8 4h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>`,
  `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="2" y="2" width="7" height="7" rx="2" stroke="currentColor" stroke-width="1.8"/><rect x="11" y="2" width="7" height="7" rx="2" stroke="currentColor" stroke-width="1.8"/><rect x="2" y="11" width="7" height="7" rx="2" stroke="currentColor" stroke-width="1.8"/><rect x="11" y="11" width="7" height="7" rx="2" stroke="currentColor" stroke-width="1.8"/></svg>`,
  `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M2 5h10v8H2zM12 8h4l2 3v2h-6V8z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="5.5" cy="14.5" r="1.5" stroke="currentColor" stroke-width="1.5"/><circle cx="14.5" cy="14.5" r="1.5" stroke="currentColor" stroke-width="1.5"/></svg>`,
];
---

<section class="section" id="features">
  <div class="container">
    <div class="section-head reveal">
      <div class="section-tag">{t.ben_tag}</div>
      <h2 class="section-title">{t.ben_title}</h2>
      <p class="section-sub">{t.ben_sub}</p>
    </div>
    <div class="benefits-grid">
      {t.ben.map((b, i) => (
        <div class="benefit-card reveal" style={`transition-delay:${i * 0.08}s`}>
          <div class="benefit-icon" style={`background:${iconBgs[i]};color:${iconColors[i]}`} set:html={icons[i]}></div>
          <div class="benefit-title">{b.title}</div>
          <div class="benefit-desc">{b.desc}</div>
        </div>
      ))}
    </div>
  </div>
</section>
