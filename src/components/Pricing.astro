---
import { T, type Lang } from '../i18n/translations';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = T[lang];
const currency = lang === 'uz' ? "so'm" : lang === 'ru' ? 'сум' : 'UZS';
---

<section class="section section-alt" id="pricing">
  <div class="container">
    <div class="section-head center reveal">
      <div class="section-tag">{t.price_tag}</div>
      <h2 class="section-title">{t.price_title}</h2>
      <p class="section-sub">{t.price_sub}</p>
    </div>
    <div class="pricing-grid">
      {t.plans.map((p, i) => (
        <div class={`pricing-card reveal${p.featured ? ' featured' : ''}`} style={`transition-delay:${i * 0.1}s`}>
          {p.featured && (
            <div style="display:inline-flex;align-items:center;gap:6px;background:rgba(26,31,13,0.12);border-radius:50px;padding:4px 12px;font-size:11px;font-weight:700;color:#1a1f0d;margin-bottom:12px;">
              ✦ {lang === 'uz' ? 'Mashhur' : lang === 'ru' ? 'Популярный' : 'Most popular'}
            </div>
          )}
          <div class="pricing-plan">{p.name}</div>
          <div class="pricing-price">{p.price}</div>
          <div class="pricing-per">
            {p.per ? `${currency} ${p.per}` : (lang === 'uz' ? 'Murojaat qiling' : lang === 'ru' ? 'Свяжитесь' : 'Contact us')}
          </div>
          <ul class="pricing-features">
            {p.feats.map((f) => (
              <li class="pricing-feature">
                <div class="pf-check">
                  <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                    <path d="M2 5l2.5 2.5L8 3" stroke={p.featured ? '#1a1f0d' : '#8aaa00'} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <a
            href={i === 2 ? '/contact' : '/signup'}
            class={`btn ${p.featured ? 'btn-ghost' : 'btn-outline'}`}
            style={`width:100%;justify-content:center;${p.featured ? 'background:rgba(26,31,13,0.12);border-color:rgba(26,31,13,0.25);color:#1a1f0d;' : ''}`}
          >
            {i === 2 ? t.contact_us : t.cta1}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
