---
import { T, type Lang } from '../i18n/translations';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = T[lang];
const numBgs = ['#a5c113', '#8aaa00', '#d97706'];
---

<section class="section section-alt" id="how">
  <div class="container">
    <div class="section-head center reveal">
      <div class="section-tag">{t.how_tag}</div>
      <h2 class="section-title">{t.how_title}</h2>
      <p class="section-sub">{t.how_sub}</p>
    </div>
    <div class="steps">
      {t.steps.map((s, i) => (
        <div class="step reveal" style={`transition-delay:${i * 0.1}s`}>
          <div
            class="step-num"
            style={`background:${numBgs[i]};box-shadow:0 4px 16px ${numBgs[i]}55;color:${i===0?'#1a1f0d':'#fff'}`}
          >
            {s.n}
          </div>
          <div class="step-title">{s.title}</div>
          <div class="step-desc">{s.desc}</div>
        </div>
      ))}
    </div>
  </div>
</section>
