---
import { T, type Lang } from '../i18n/translations';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = T[lang];
const avColors = ['#a5c113', '#8aaa00', '#d97706'];
---

<section class="section">
  <div class="container">
    <div class="section-head center reveal">
      <div class="section-tag">{t.testi_tag}</div>
      <h2 class="section-title">{t.testi_title}</h2>
    </div>
    <div class="testi-grid">
      {t.testis.map((tt, i) => (
        <div class="testi-card reveal" style={`transition-delay:${i * 0.1}s`}>
          <div class="testi-stars">
            {[1,2,3,4,5].map(() => <span class="testi-star">★</span>)}
          </div>
          <p class="testi-text">"{tt.text}"</p>
          <div class="testi-author">
            <div
              class="testi-av"
              style={`background:${avColors[i]};color:${i===0?'#1a1f0d':'#fff'}`}
            >
              {tt.init}
            </div>
            <div>
              <div class="testi-name">{tt.name}</div>
              <div class="testi-role">{tt.role}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
